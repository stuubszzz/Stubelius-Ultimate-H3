   "widgets_values": [
    "First/Last Frame — zero, one, or two frame images",
    "16:9 (Widescreen)",
    12.5,
    12.5,
    43,
    "fixed",
    "{\"characters\": [null, null, null], \"chunks\": [{\"segments\": [{\"prompt\": \"A medium close-up frames a bearded glassblower in his fifties with rolled-up sleeves and a worn leather apron, standing at his workbench in a dark workshop lit only by the orange glow of a furnace. He slowly rotates a long steel blowpipe, and a glowing orange bulb of molten glass turns at its tip, throwing warm flickering light across his face, beard and forearms. Tiny glowing embers drift upward past him. He leans in and blows gently into the pipe, and the molten bulb slowly swells and brightens. Behind him the open furnace mouth burns yellow-white, and shelves of finished blue, green and amber glass vases sparkle in the firelight. The camera pushes in with small amplitude at slow speed toward the glowing glass.\", \"weight\": 1, \"duration_hint\": \"12.5\", \"speakerCharIdxs\": []}], \"prompt_gen_enabled\": false, \"prompt_gen_brief\": \"\", \"prompt_gen_draft_text\": \"\", \"prompt_gen_committed_text\": \"\", \"style_line\": \"Live-action, cinematic, shallow depth of field, warm low-key lighting\", \"overall_soundscape\": \"The deep, steady roar of the furnace fills the workshop, with the soft rhythmic rolling of the steel pipe on the bench rails, faint crackles from the cooling glass, and the glassblower's slow, controlled breath as he blows into the pipe.\", \"non_diegetic_music\": \"A solo cello plays long sustained notes over a soft low synthesizer drone, at a slow tempo with gradual swells in volume.\", \"loras\": []}], \"background\": {}, \"refVideos\": [null, null, null], \"refAudios\": [null, null, null], \"dialogue_language\": \"English\", \"prompt_gen_provider\": \"ollama\", \"prompt_gen_base_url\": \"\", \"prompt_gen_model\": \"\"}",
    ""
